# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# PostgreSQL is the production database. If this is left unconfigured or the
# server is unreachable, the app falls back to a local SQLite file so you can
# start without provisioning anything.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/seo_automation
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Security  —  REQUIRED in production
# ─────────────────────────────────────────────────────────────────────────────
# Signs JWTs and derives the credential-encryption key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates all sessions AND makes stored integration
# credentials undecryptable, so treat it as a permanent per-environment secret.
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOW_REGISTRATION=true

# Optional: creates this administrator on first boot (useful for containers).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# ─────────────────────────────────────────────────────────────────────────────
# Crawler
# ─────────────────────────────────────────────────────────────────────────────
MAX_PAGES=5000
REQUEST_TIMEOUT=15
CRAWL_DELAY=0
CONCURRENT_WORKERS=25
MAX_RETRIES=3
RATE_LIMIT_PER_SECOND=20
CRAWL_TIME_BUDGET_SECONDS=3600
RESPECT_ROBOTS_TXT=true
# Never enable in production: this disables SSRF protection.
ALLOW_LOCAL_CRAWL=false

# JavaScript rendering (Playwright). Fallback only — run `playwright install chromium`.
RENDER_ENABLED=true
RENDER_CONCURRENCY=3
RENDER_TIMEOUT_MS=15000
RENDER_MIN_TEXT_LENGTH=400
RENDER_MAX_PAGES=250

# ─────────────────────────────────────────────────────────────────────────────
# Priority engine weights  (must sum to 1.0)
# ─────────────────────────────────────────────────────────────────────────────
PRIORITY_WEIGHT_SEO_SEVERITY=0.40
PRIORITY_WEIGHT_GA4_ACTIVITY=0.30
PRIORITY_WEIGHT_GSC_SEARCH=0.20
PRIORITY_WEIGHT_SEMRUSH_OPPORTUNITY=0.10
PRIORITY_METRIC_WINDOW_DAYS=28

# ─────────────────────────────────────────────────────────────────────────────
# AI
# ─────────────────────────────────────────────────────────────────────────────
AI_ENABLED=true
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_MAX_PAGES=100
AI_CONCURRENCY=5
AI_MAX_CONTENT_LENGTH=8000
AI_SEO_SCORE_THRESHOLD=90

# ─────────────────────────────────────────────────────────────────────────────
# Integrations
# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth (Search Console + GA4). Create credentials at
# https://console.cloud.google.com/apis/credentials and add the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback

# Semrush API key (https://www.semrush.com/api-analytics/).
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=us

INTEGRATION_SYNC_BACKFILL_DAYS=90
INTEGRATION_SYNC_WINDOW_DAYS=3

# Shared secret configured on the GitHub webhook. Required to accept deliveries.
GITHUB_WEBHOOK_SECRET=
